# Fins de ligne : LF dans le dépôt et dans la copie de travail, quel que soit l'OS.
* text=auto eol=lf

# Fichiers binaires
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.ofx -text

# Relevés OFX de test : octets conservés tels quels (Windows-1252, fins de ligne CRLF)
apps/api/test/fixtures/ofx/*.ofx binary
