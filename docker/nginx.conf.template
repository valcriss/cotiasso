# IP réelle du client : seules les adresses de TRUSTED_PROXY_CIDR (votre reverse proxy HTTPS) peuvent la fournir
# via X-Forwarded-For. Sans cela, l'en-tête envoyé par un client est ignoré (pas de contournement du délai par IP).
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # Le préfixe /api est retiré avant d'atteindre l'API (comme le proxy de développement).
    location /api/ {
        proxy_pass http://api:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        client_max_body_size 25m;
    }

    # Fichiers hachés par Angular : cache long. Le reste revient à index.html (routage côté client).
    location ~* \.(?:js|css|woff2?|ico)$ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
        expires -1;
    }
}
