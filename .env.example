# Copier vers .env (ignoré par git). Valeurs de développement uniquement.
POSTGRES_USER=cotiasso
POSTGRES_PASSWORD=cotiasso
POSTGRES_DB=cotiasso
POSTGRES_PORT=5433

DATABASE_URL=postgresql://cotiasso:cotiasso@localhost:5433/cotiasso
API_PORT=3000
API_HOST=127.0.0.1

# Authentification : HTTP local sans HTTPS, donc cookie non Secure (laisser true en production).
COOKIE_SECURE=false
# Durées de session (valeurs par défaut) : inactivité en minutes, durée maximale en heures.
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
