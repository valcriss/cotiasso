# Copier vers .env (ignoré par git). Valeurs de développement uniquement.
POSTGRES_USER=cotiasso
POSTGRES_PASSWORD=cotiasso
POSTGRES_DB=cotiasso
POSTGRES_PORT=5433

DATABASE_URL=postgresql://cotiasso:cotiasso@localhost:5433/cotiasso
API_PORT=3000
API_HOST=127.0.0.1

# Authentification : HTTP local sans HTTPS, donc cookie non Secure (laisser true en production).
COOKIE_SECURE=false
# Durées de session (valeurs par défaut) : inactivité en minutes, durée maximale en heures.
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Emails d'invitation et de réinitialisation (facultatif ; sans SMTP_HOST, le lien est seulement affiché à l'administrateur).
# Pour les essayer en local : un faux serveur de messagerie comme MailDev (docker run -p 1080:1080 -p 1025:1025 maildev/maildev),
# puis décommenter les lignes ci-dessous et lire les messages sur http://localhost:1080.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=no-reply@cotiasso.test
# PUBLIC_URL=http://localhost:4200

# Chiffrement des secrets MFA (TOTP) : 32 octets en base64. Clé de DÉVELOPPEMENT seulement ; en production,
# en générer une avec `openssl rand -base64 32` et la sauvegarder avec la base (sans elle, les MFA sont illisibles).
MFA_ENCRYPTION_KEY=fvk57CMg3ywklmXAYjuG0sTS7hDYqdTUdy9i6HPZ1R4=

# Dossier privé des documents déposés (relatif à apps/api en développement ; ignoré par git).
DOCUMENTS_DIR=../../storage/documents
DOCUMENTS_MAX_MB=25

# Notes de version affichées dans Paramètres › Exploitation (relatif à apps/api en développement ; l'image Docker fournit le sien).
CHANGELOG_FILE=../../CHANGELOG.md
