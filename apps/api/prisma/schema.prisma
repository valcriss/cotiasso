generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Journal d'audit en ajout seul : les UPDATE et DELETE sont refusés par un déclencheur (voir la migration).
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  occurredAt    DateTime @default(now()) @db.Timestamptz(3)
  actorId       String?  @db.Uuid
  action        String
  objectType    String
  objectId      String?
  justification String?
  details       Json?

  @@index([objectType, objectId])
  @@index([occurredAt])
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  displayName  String
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  version      Int        @default(1)
  sessions     Session[]
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  // Empreinte SHA-256 du jeton du cookie : le jeton lui-même n'est jamais stocké.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  // Fin absolue de la session ; l'inactivité se calcule à partir de lastSeenAt.
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  // Email normalisé tel que saisi, qu'il corresponde ou non à un compte (évite d'en révéler l'existence).
  email      String?
  ipAddress  String?
  success    Boolean

  @@index([email, occurredAt])
  @@index([ipAddress, occurredAt])
}

// Jeton à usage unique de l'assistant initial : généré au démarrage tant qu'aucun compte n'existe.
model SetupToken {
  id        String    @id @default(uuid()) @db.Uuid
  // Empreinte SHA-256 ; le jeton lui-même n'apparaît que dans les logs au moment de sa création.
  tokenHash String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
}
