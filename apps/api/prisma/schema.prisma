generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Journal d'audit en ajout seul : les UPDATE et DELETE sont refusés par un déclencheur (voir la migration).
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  // Ordre de la chaîne d'intégrité ; les événements antérieurs à la chaîne n'ont pas d'empreinte.
  seq           BigInt   @unique @default(autoincrement())
  hash          String?
  previousHash  String?
  occurredAt    DateTime @default(now()) @db.Timestamptz(3)
  actorId       String?  @db.Uuid
  action        String
  objectType    String
  objectId      String?
  justification String?
  details       Json?

  @@index([objectType, objectId])
  @@index([occurredAt])
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  member           Member?
  email            String            @unique
  displayName      String
  passwordHash     String
  status           UserStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  version          Int               @default(1)
  sessions         Session[]
  roleAssignments  RoleAssignment[]
  passwordTokens   PasswordToken[]
  mfaCredential    MfaCredential?
  mfaRecoveryCodes MfaRecoveryCode[]
  managedProjects  Project[]         @relation("ProjectManager")
  projectParticipations ProjectParticipant[]
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id])
  // Empreinte SHA-256 du jeton du cookie : le jeton lui-même n'est jamais stocké.
  tokenHash     String    @unique
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  // Fin absolue de la session ; l'inactivité se calcule à partir de lastSeenAt.
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  // Renseigné quand le second facteur a été vérifié pour cette session.
  mfaVerifiedAt DateTime? @db.Timestamptz(3)
  ipAddress     String?
  userAgent     String?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  // Email normalisé tel que saisi, qu'il corresponde ou non à un compte (évite d'en révéler l'existence).
  email      String?
  ipAddress  String?
  success    Boolean

  @@index([email, occurredAt])
  @@index([ipAddress, occurredAt])
}

// Jeton à usage unique de l'assistant initial : généré au démarrage tant qu'aucun compte n'existe.
model SetupToken {
  id        String    @id @default(uuid()) @db.Uuid
  // Empreinte SHA-256 ; le jeton lui-même n'apparaît que dans les logs au moment de sa création.
  tokenHash String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
}

// Rôle = modèle modifiable de permissions (jamais de privilège codé en dur selon le nom du rôle).
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  description String           @default("")
  // Clés du catalogue de permissions (voir src/authz/permissions.ts), validées par l'application.
  permissions String[]
  // Exige une authentification à deux facteurs de tout utilisateur qui détient ce rôle (attribution active).
  requiresMfa Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  version     Int              @default(1)
  assignments RoleAssignment[]
}

// Attribution d'un rôle à un utilisateur, datée. L'historique est conservé : on révoque, on ne supprime pas.
// Portée globale uniquement pour l'instant ; la portée projet s'ajoutera avec l'entité Project (lot 2a.4).
model RoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  roleId    String    @db.Uuid
  role      Role      @relation(fields: [roleId], references: [id])
  // Portée projet (ADR 0022) : absent = attribution globale. Ne change jamais (déclencheur SQL).
  projectId String?   @db.Uuid
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  startsAt  DateTime  @default(now()) @db.Timestamptz(3)
  endsAt    DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String?   @db.Uuid
  revokedBy String?   @db.Uuid

  @@index([userId])
  @@index([roleId])
  @@index([projectId])
}

enum PasswordTokenPurpose {
  INVITATION
  RESET
}

// Jeton à usage unique pour définir un mot de passe : invitation d'un nouveau compte ou réinitialisation.
// Généré par un administrateur ; seule l'empreinte est stockée, le jeton n'est montré qu'une fois.
model PasswordToken {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  user      User                 @relation(fields: [userId], references: [id])
  tokenHash String               @unique
  purpose   PasswordTokenPurpose
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  expiresAt DateTime             @db.Timestamptz(3)
  usedAt    DateTime?            @db.Timestamptz(3)
  createdBy String?              @db.Uuid

  @@index([userId])
}

// Secret TOTP d'un utilisateur, chiffré au repos. Inactif (enabledAt nul) tant que l'inscription n'est pas confirmée.
model MfaCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  user            User      @relation(fields: [userId], references: [id])
  secretEncrypted String
  enabledAt       DateTime? @db.Timestamptz(3)
  // Dernier pas TOTP accepté : empêche de rejouer un code.
  lastUsedStep    Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
}

// Code de secours à usage unique ; seule l'empreinte HMAC est stockée.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String    @unique
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

// Paramètres de l'association, versionnés et datés : une évolution ne modifie jamais l'historique.
// Le contenu est un JSON validé par un schéma côté serveur avant écriture (voir src/settings/schemas.ts).
model SettingsVersion {
  id            String   @id @default(uuid()) @db.Uuid
  section       String
  effectiveFrom DateTime @default(now()) @db.Timestamptz(3)
  payload       Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  createdBy     String?  @db.Uuid

  @@index([section, effectiveFrom])
}

// État d'activation des modules fonctionnels (TVA, immobilisations, constatés d'avance, etc.).
model ModuleActivation {
  id            String    @id @default(uuid()) @db.Uuid
  key           String    @unique
  activatedAt   DateTime  @db.Timestamptz(3)
  deactivatedAt DateTime? @db.Timestamptz(3)
  activatedBy   String?   @db.Uuid
  deactivatedBy String?   @db.Uuid
}

// Document logique : un seul enregistrement, des versions immuables, des liens multiples vers d'autres objets.
// Un document ne se supprime pas : il s'archive.
model Document {
  id         String            @id @default(uuid()) @db.Uuid
  title      String
  category   String
  // Un document restreint exige la permission documents.restricted:view, quel que soit le projet ou l'objet lié.
  restricted Boolean           @default(false)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  createdBy  String?           @db.Uuid
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  archivedAt DateTime?         @db.Timestamptz(3)
  versions   DocumentVersion[]
  links      DocumentLink[]

  @@index([category])
}

// Version d'un document. Immuable (déclencheur SQL) : remplacer un fichier crée une nouvelle version.
model DocumentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @db.Uuid
  document     Document @relation(fields: [documentId], references: [id])
  number       Int
  // Nom d'origine, purement informatif : il ne sert jamais de chemin sur le serveur.
  originalName String
  mimeType     String
  size         Int
  sha256       String
  // Clé opaque du fichier dans le stockage privé.
  storageKey   String   @unique
  comment      String?
  uploadedAt   DateTime @default(now()) @db.Timestamptz(3)
  uploadedBy   String?  @db.Uuid

  @@unique([documentId, number])
  @@index([sha256])
}

// Lien d'un document vers un objet métier (membre, projet, transaction, subvention...). Plusieurs liens possibles.
model DocumentLink {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id])
  objectType String
  objectId   String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  createdBy  String?  @db.Uuid

  @@unique([documentId, objectType, objectId])
  @@index([objectType, objectId])
}

enum FiscalYearStatus {
  OPEN
  CLOSING
  CLOSED
}

// Exercice comptable aux dates paramétrables. Pas de chevauchement (contrainte d'exclusion en base) ; jamais supprimé.
model FiscalYear {
  id        String           @id @default(uuid()) @db.Uuid
  label     String
  start     DateTime         @db.Date
  end       DateTime         @db.Date
  status    FiscalYearStatus @default(OPEN)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  createdBy String?          @db.Uuid
  closedAt  DateTime?        @db.Timestamptz(3)
  closedBy  String?          @db.Uuid

  entries      JournalEntry[] @relation("EntryYear")
  openingEntry JournalEntry?  @relation("Carry")
  counters     EntryCounter[]
}

enum JournalType {
  BANK
  CASH
  PURCHASES
  REVENUE
  MISC
  OPENING
}

// Journal comptable. Le code et le type ne changent plus une fois créés (la numérotation en dépend) ; jamais supprimé.
model Journal {
  id        String      @id @default(uuid()) @db.Uuid
  code      String      @unique
  label     String
  type      JournalType
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  createdBy String?     @db.Uuid

  entries          JournalEntry[]
  counters         EntryCounter[]
  financialAccount FinancialAccount?
}

// Compte du plan comptable. Le numéro est définitif ; un compte se désactive, il ne se supprime jamais.
model Account {
  id         String   @id @default(uuid()) @db.Uuid
  number     String   @unique
  label      String
  active     Boolean  @default(true)
  // Rubrique de rapport (bilan, compte de résultat) ; absente = « non classé », signalé par un contrôle.
  reportLine String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  createdBy  String?  @db.Uuid

  lines                   JournalLine[]
  financialAccount        FinancialAccount?
  proposedForTransactions Transaction[]
  budgetLines             BudgetLine[]
  commitments             Commitment[]
  operationCategories     OperationCategory[]
}

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum EntryKind {
  NORMAL
  ADJUSTMENT
  REVERSAL
  OPENING
}

// Écriture comptable. Brouillon modifiable ; une fois comptabilisée (numérotée), elle ne change plus : on la
// contrepasse. Les garanties (équilibre, numérotation, exercice ouvert, immuabilité) sont des déclencheurs SQL.
model JournalEntry {
  id            String      @id @default(uuid()) @db.Uuid
  fiscalYearId  String      @db.Uuid
  journalId     String      @db.Uuid
  date          DateTime    @db.Date
  label         String
  reference     String?
  kind          EntryKind   @default(NORMAL)
  status        EntryStatus @default(DRAFT)
  // Attribué à la comptabilisation, par journal et par exercice, sans trou (voir EntryCounter).
  number        Int?
  // Contrôle de version optimiste du brouillon.
  version       Int         @default(1)
  postedAt      DateTime?   @db.Timestamptz(3)
  postedBy      String?     @db.Uuid
  reversalOfId  String?     @unique @db.Uuid
  // Exercice dont cette écriture d'à-nouveaux reporte les soldes : un exercice ne se reporte qu'une fois (unique).
  carriesFromId String?     @unique @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  createdBy     String?     @db.Uuid

  fiscalYear   FiscalYear         @relation("EntryYear", fields: [fiscalYearId], references: [id], onDelete: Restrict)
  carriesFrom  FiscalYear?        @relation("Carry", fields: [carriesFromId], references: [id], onDelete: Restrict)
  journal      Journal            @relation(fields: [journalId], references: [id], onDelete: Restrict)
  reversalOf   JournalEntry?      @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy   JournalEntry?      @relation("Reversal")
  lines        JournalLine[]
  matches      TreasuryMatch[]
  recoveryItem RecoveryBatchItem?
  openingSituation OpeningSituation?
  settledCommitments Commitment[]

  @@unique([journalId, fiscalYearId, number])
  @@index([fiscalYearId, date])
  @@index([status])
}

model JournalLine {
  id        String  @id @default(uuid()) @db.Uuid
  entryId   String  @db.Uuid
  position  Int
  accountId String  @db.Uuid
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  label     String?

  entry       JournalEntry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  allocations AnalyticalAllocation[]

  @@unique([entryId, position])
  @@index([accountId])
}

// Dernier numéro attribué par journal et exercice, incrémenté sous verrou de ligne dans la transaction de
// comptabilisation (pas de SEQUENCE PostgreSQL : un rollback ne laisse aucun trou).
model EntryCounter {
  journalId    String @db.Uuid
  fiscalYearId String @db.Uuid
  lastNumber   Int

  journal    Journal    @relation(fields: [journalId], references: [id], onDelete: Restrict)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@id([journalId, fiscalYearId])
}

enum ProjectStatus {
  PREPARATION
  ACTIVE
  FINISHED
  ARCHIVED
}

// Projet : axe analytique des charges et produits. Un projet utilisé n'est jamais supprimé. Le projet permanent
// « Fonctionnement de l'association » (unique) reçoit les opérations générales.
model Project {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique
  name        String
  description String        @default("")
  status      ProjectStatus @default(PREPARATION)
  permanent   Boolean       @default(false)
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  managerId   String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  createdBy   String?       @db.Uuid

  manager         User?                  @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  allocations     AnalyticalAllocation[]
  roleAssignments RoleAssignment[]
  transactions    Transaction[]
  participants    ProjectParticipant[]
  budgets         BudgetVersion[]
  commitments     Commitment[]
  grantAllocations GrantProjectAllocation[]
}

// Ventilation analytique d'une ligne de charge ou de produit : une ou plusieurs parts de projet dont le total égale
// le montant de la ligne (contrôlé à la comptabilisation).
model AnalyticalAllocation {
  id        String  @id @default(uuid()) @db.Uuid
  lineId    String  @db.Uuid
  projectId String  @db.Uuid
  amount    Decimal @db.Decimal(14, 2)

  line     JournalLine               @relation(fields: [lineId], references: [id], onDelete: Cascade)
  project  Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  fundings FundingExpenseAllocation[]

  @@unique([lineId, projectId])
  @@index([projectId])
}

enum FinancialAccountType {
  BANK
  CASH
}

// Compte bancaire ou caisse. Rattaché à un compte de trésorerie (classe 5) et à un journal propres, définitifs. Le solde
// initial est une information datée (il ne crée pas d'écriture) ; un compte utilisé s'archive, il ne se supprime pas.
model FinancialAccount {
  id             String               @id @default(uuid()) @db.Uuid
  name           String
  type           FinancialAccountType
  currency       String               @default("EUR")
  // Référence utile (ex. fin d'IBAN, agence) ; jamais de secret bancaire.
  reference      String?
  accountId      String               @unique @db.Uuid
  journalId      String               @unique @db.Uuid
  openedOn       DateTime             @db.Date
  openingBalance Decimal              @default(0) @db.Decimal(14, 2)
  archivedOn     DateTime?            @db.Date
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  createdBy      String?              @db.Uuid

  account         Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  journal         Journal             @relation(fields: [journalId], references: [id], onDelete: Restrict)
  transactions    Transaction[]
  statements      BankStatement[]
  imports         ImportBatch[]
  matches         TreasuryMatch[]
  reconciliations Reconciliation[]
  recoveryItems   RecoveryBatchItem[]
}

// Solde fourni par un relevé à une date : sert de preuve et de point de contrôle, en ajout seul. Un solde non contrôlé
// n'est jamais présenté comme rapproché.
model BankStatement {
  id                 String   @id @default(uuid()) @db.Uuid
  financialAccountId String   @db.Uuid
  periodStart        DateTime @db.Date
  periodEnd          DateTime @db.Date
  closingBalance     Decimal  @db.Decimal(14, 2)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  createdBy          String?  @db.Uuid

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  reconciliations  Reconciliation[]

  @@index([financialAccountId, periodEnd])
}

enum TransactionOrigin {
  MANUAL
  IMPORT
}

// Mouvement financier (≠ écriture comptable) : montant signé (encaissement positif, décaissement négatif). Les statuts
// de présence sur relevé, qualification, comptabilisation et rapprochement sont des dimensions distinctes.
model Transaction {
  id                   String            @id @default(uuid()) @db.Uuid
  financialAccountId   String            @db.Uuid
  operationDate        DateTime          @db.Date
  valueDate            DateTime?         @db.Date
  amount               Decimal           @db.Decimal(14, 2)
  label                String
  reference            String?
  origin               TransactionOrigin @default(MANUAL)
  // Identifiant fourni par la banque et sa source : garantit l'idempotence des imports.
  source               String?
  externalId           String?
  // Qualification : projet et compte de contrepartie proposés (préremplissent l'écriture, ne la créent pas).
  projectId            String?           @db.Uuid
  counterpartAccountId String?           @db.Uuid
  // Rapprochement bancaire dans lequel la transaction est pointée (ADR 0018).
  reconciliationId     String?           @db.Uuid
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  createdBy            String?           @db.Uuid

  financialAccount   FinancialAccount    @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  counterpartAccount Account?            @relation(fields: [counterpartAccountId], references: [id], onDelete: Restrict)
  reconciliation     Reconciliation?     @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  paymentAllocations PaymentAllocation[]
  grantPayments      GrantPayment[]
  importedFrom       ImportLine[]        @relation("ImportResult")
  matchedBy          ImportLine[]        @relation("ImportMatch")
  matches            TreasuryMatch[]
  transferOut        Transfer?           @relation("TransferOut")
  transferIn         Transfer?           @relation("TransferIn")

  @@index([financialAccountId, operationDate])
}

enum TreasuryMatchStatus {
  ACTIVE
  ENDED
}

// Liaison d'une transaction à l'écriture qui la comptabilise (ADR 0017). Terminée (ENDED, conservée) quand l'écriture
// est contrepassée ; un brouillon supprimé emporte sa liaison. Un seul lien actif par transaction et par écriture et
// compte financier (index partiels en SQL).
model TreasuryMatch {
  id                 String              @id @default(uuid()) @db.Uuid
  transactionId      String              @db.Uuid
  entryId            String              @db.Uuid
  financialAccountId String              @db.Uuid
  status             TreasuryMatchStatus @default(ACTIVE)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  createdBy          String?             @db.Uuid
  endedAt            DateTime?           @db.Timestamptz(3)

  transaction      Transaction      @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  entry            JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([entryId])
}

// Virement interne : deux transactions reliées (sortie et entrée), sans charge ni produit (CA-05).
model Transfer {
  id               String   @id @default(uuid()) @db.Uuid
  outTransactionId String   @unique @db.Uuid
  inTransactionId  String   @unique @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  createdBy        String?  @db.Uuid

  outTransaction Transaction @relation("TransferOut", fields: [outTransactionId], references: [id], onDelete: Restrict)
  inTransaction  Transaction @relation("TransferIn", fields: [inTransactionId], references: [id], onDelete: Restrict)
}

enum RecoveryBatchStatus {
  OPEN
  COMPLETED
  ABANDONED
}

enum RecoveryItemKind {
  OPENING
  TRANSACTION
}

// Lot de reprise : brouillons créés en masse, comptabilisés ensemble ou abandonnés (ADR 0019). Jamais supprimé.
model RecoveryBatch {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  note        String?
  status      RecoveryBatchStatus @default(OPEN)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  createdBy   String?             @db.Uuid
  closedAt    DateTime?           @db.Timestamptz(3)
  abandonedAt DateTime?           @db.Timestamptz(3)
  abandonedBy String?             @db.Uuid

  items RecoveryBatchItem[]
}

// Une écriture d'un lot. Un brouillon supprimé emporte son élément ; une écriture comptabilisée le garde (historique).
model RecoveryBatchItem {
  id                 String           @id @default(uuid()) @db.Uuid
  batchId            String           @db.Uuid
  entryId            String           @unique @db.Uuid
  kind               RecoveryItemKind
  financialAccountId String           @db.Uuid
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)

  batch            RecoveryBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  entry            JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)

  @@index([batchId])
}

enum ReconciliationStatus {
  IN_PROGRESS
  VALIDATED
  CANCELLED
}

// Rapprochement d'un compte avec un relevé par pointage de transactions (ADR 0018). Un seul en cours par compte, un seul
// non annulé par relevé (index partiels en SQL) ; les règles de validation et de figement sont dans les déclencheurs.
model Reconciliation {
  id                 String               @id @default(uuid()) @db.Uuid
  financialAccountId String               @db.Uuid
  statementId        String               @db.Uuid
  periodEnd          DateTime             @db.Date
  // Solde rapproché de départ : celui du dernier rapprochement validé, ou le solde d'ouverture du compte.
  openingBalance     Decimal              @db.Decimal(14, 2)
  closingBalance     Decimal              @db.Decimal(14, 2)
  status             ReconciliationStatus @default(IN_PROGRESS)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  createdBy          String?              @db.Uuid
  validatedAt        DateTime?            @db.Timestamptz(3)
  validatedBy        String?              @db.Uuid
  cancelledAt        DateTime?            @db.Timestamptz(3)
  cancelledBy        String?              @db.Uuid

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  statement        BankStatement    @relation(fields: [statementId], references: [id], onDelete: Restrict)
  transactions     Transaction[]

  @@index([financialAccountId, periodEnd])
}

enum ImportBatchStatus {
  ANALYZED
  COMMITTED
  CANCELLED
}

enum ImportLineStatus {
  NEW
  DUPLICATE
  PROBABLE_MATCH
  ERROR
}

enum ImportDecision {
  CREATE
  LINK
  SKIP
}

// Import d'un relevé : l'analyse n'écrit aucune transaction ; la confirmation crée ou rattache, dans une transaction
// unique. Un même fichier (empreinte) ne se confirme qu'une fois par compte (idempotence).
model ImportBatch {
  id                 String            @id @default(uuid()) @db.Uuid
  financialAccountId String            @db.Uuid
  fileName           String
  fileHash           String
  format             String
  status             ImportBatchStatus @default(ANALYZED)
  periodStart        DateTime?         @db.Date
  periodEnd          DateTime?         @db.Date
  ledgerBalance      Decimal?          @db.Decimal(14, 2)
  ledgerBalanceDate  DateTime?         @db.Date
  // Fin du numéro de compte du fichier, pour que l'utilisateur vérifie qu'il importe sur le bon compte.
  accountHint        String?
  summary            Json
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  createdBy          String?           @db.Uuid
  committedAt        DateTime?         @db.Timestamptz(3)
  committedBy        String?           @db.Uuid

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  lines            ImportLine[]

  @@index([financialAccountId, createdAt])
}

// Ligne d'un relevé : données brutes conservées telles quelles, classement de l'analyse, puis décision de l'utilisateur.
model ImportLine {
  id                   String           @id @default(uuid()) @db.Uuid
  batchId              String           @db.Uuid
  position             Int
  raw                  Json
  fitId                String?
  operationDate        DateTime?        @db.Date
  amount               Decimal?         @db.Decimal(14, 2)
  label                String
  reference            String?
  status               ImportLineStatus
  errors               Json
  // Transactions saisies à la main qui ressemblent à la ligne (rapprochement proposé, jamais automatique).
  candidates           Json
  // Pour un doublon : la transaction déjà enregistrée avec le même identifiant bancaire.
  matchedTransactionId String?          @db.Uuid
  decision             ImportDecision?
  // Transaction créée (CREATE) ou rattachée (LINK) à la confirmation.
  transactionId        String?          @db.Uuid

  batch              ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  matchedTransaction Transaction? @relation("ImportMatch", fields: [matchedTransactionId], references: [id], onDelete: Restrict)
  transaction        Transaction? @relation("ImportResult", fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([batchId, position])
  @@index([transactionId])
}

enum MemberStatus {
  ACTIVE
  FORMER
}

// Catégorie de membre (ex. « Adulte », « Étudiant »), configurable. ADR 0023.
model MemberCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  createdBy String?  @db.Uuid

  members Member[]
  tariffs Tariff[]
}

// Membre de l'association : jamais supprimé (l'historique comptable s'y réfère), anonymisable une fois sorti.
model Member {
  id           String       @id @default(uuid()) @db.Uuid
  projectParticipations ProjectParticipant[]
  firstName    String
  lastName     String
  email        String?
  phone        String?
  addressLine  String?
  postalCode   String?
  city         String?
  categoryId   String?      @db.Uuid
  status       MemberStatus @default(ACTIVE)
  joinedOn     DateTime?    @db.Date
  leftOn       DateTime?    @db.Date
  // Compte de connexion lié, facultatif : un membre n'a pas besoin d'un compte.
  userId       String?      @unique @db.Uuid
  note         String?
  anonymizedAt DateTime?    @db.Timestamptz(3)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  createdBy    String?      @db.Uuid

  category    MemberCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  user        User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  offices     MemberOffice[]
  memberships Membership[]

  @@index([lastName, firstName])
  @@index([status])
}

// Fonction ou mandat d'un membre (Président, Trésorier…), avec ses dates.
model MemberOffice {
  id        String    @id @default(uuid()) @db.Uuid
  memberId  String    @db.Uuid
  title     String
  startsOn  DateTime  @db.Date
  endsOn    DateTime? @db.Date
  note      String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String?   @db.Uuid

  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([memberId])
}

enum MembershipMode {
  PAYMENT
  VALIDATION
  START_DATE
}

enum MembershipOrigin {
  PAYMENT
  VALIDATION
  START_DATE
  EXEMPTION
}

enum MembershipStatus {
  PENDING
  EFFECTIVE
  CANCELLED
}

// Campagne d'adhésion : dates explicites, sans chevauchement ; le mode d'adhésion effective est figé à la création. ADR 0023.
model Campaign {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  startsOn      DateTime       @db.Date
  endsOn        DateTime       @db.Date
  effectiveMode MembershipMode
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  createdBy     String?        @db.Uuid

  tariffs     Tariff[]
  memberships Membership[]
}

model Tariff {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  label      String
  amount     Decimal  @db.Decimal(14, 2)
  categoryId String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  campaign    Campaign        @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  category    MemberCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@unique([campaignId, label])
}

// Adhésion d'un membre à une campagne : montant attendu figé, état (en attente, effective, annulée), origine de l'effet.
model Membership {
  id              String            @id @default(uuid()) @db.Uuid
  campaignId      String            @db.Uuid
  memberId        String            @db.Uuid
  tariffId        String?           @db.Uuid
  expectedAmount  Decimal           @db.Decimal(14, 2)
  exemptionReason String?
  status          MembershipStatus  @default(PENDING)
  effectiveOn     DateTime?         @db.Date
  effectiveOrigin MembershipOrigin?
  cancelledAt     DateTime?         @db.Timestamptz(3)
  cancelReason    String?
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  createdBy       String?           @db.Uuid

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  tariff   Tariff?  @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]

  @@index([campaignId])
  @@index([memberId])
}

enum AllocationKind {
  PAYMENT
  REFUND
}

// Affectation de règlement : une part d'une transaction rattachée à une adhésion. Ne crée aucune écriture comptable.
// Une affectation ne se modifie pas : elle s'annule avec un motif. ADR 0023.
model PaymentAllocation {
  id            String         @id @default(uuid()) @db.Uuid
  transactionId String         @db.Uuid
  membershipId  String         @db.Uuid
  amount        Decimal        @db.Decimal(14, 2)
  kind          AllocationKind @default(PAYMENT)
  note          String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  createdBy     String?        @db.Uuid
  cancelledAt   DateTime?      @db.Timestamptz(3)
  cancelledBy   String?        @db.Uuid
  cancelReason  String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  membership  Membership  @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([membershipId])
}

// Participant d'un projet (ADR 0024, tranche 4.1) : un membre OU un utilisateur, avec un rôle libre et des dates.
// Information seulement : aucun droit d'accès n'y est attaché (les droits restent dans les rôles et leur portée projet).
model ProjectParticipant {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @db.Uuid
  memberId  String?   @db.Uuid
  userId    String?   @db.Uuid
  role      String
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  note      String    @default("")
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String?   @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  member  Member? @relation(fields: [memberId], references: [id], onDelete: Restrict)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([projectId])
}

enum BudgetStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum BudgetLineKind {
  CHARGE
  PRODUCT
}

// Version de budget d'un projet. Brouillon modifiable, puis approuvée (immuable), puis remplacée par la suivante.
// Une seule version approuvée par projet. Un budget n'est pas de la comptabilité : il ne crée aucune écriture.
model BudgetVersion {
  id         String       @id @default(uuid()) @db.Uuid
  projectId  String       @db.Uuid
  number     Int
  label      String
  status     BudgetStatus @default(DRAFT)
  approvedAt DateTime?    @db.Timestamptz(3)
  approvedBy String?      @db.Uuid
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  createdBy  String?      @db.Uuid

  project Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lines   BudgetLine[]

  @@unique([projectId, number])
}

// Ligne de budget : un poste libre (compte facultatif), charge ou produit, sur une période explicite.
model BudgetLine {
  id          String         @id @default(uuid()) @db.Uuid
  budgetId    String         @db.Uuid
  kind        BudgetLineKind
  label       String
  accountId   String?        @db.Uuid
  periodStart DateTime       @db.Date
  periodEnd   DateTime       @db.Date
  amount      Decimal        @db.Decimal(14, 2)

  budget  BudgetVersion @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([budgetId])
}

enum CommitmentStatus {
  OPEN
  SETTLED
  CANCELLED
}

// Engagement (ADR 0024, tranche 4.2) : une dépense promise (devis, bon de commande) pas encore comptabilisée. Ce n'est pas
// de la comptabilité. Il est « soldé » quand une écriture comptabilisée qui pèse sur le projet lui est rattachée : il
// cesse alors de compter comme engagé (c'est le réalisé qui le remplace), jamais les deux. Jamais supprimé.
model Commitment {
  id             String           @id @default(uuid()) @db.Uuid
  projectId      String           @db.Uuid
  label          String
  amount         Decimal          @db.Decimal(14, 2)
  committedOn    DateTime         @db.Date
  accountId      String?          @db.Uuid
  note           String           @default("")
  status         CommitmentStatus @default(OPEN)
  settledEntryId String?          @db.Uuid
  settledAt      DateTime?        @db.Timestamptz(3)
  cancelReason   String?
  cancelledAt    DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  createdBy      String?          @db.Uuid

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  settledEntry JournalEntry? @relation(fields: [settledEntryId], references: [id], onDelete: Restrict)

  @@index([projectId, committedOn])
}

enum FunderType {
  LOCAL_AUTHORITY
  STATE
  FOUNDATION
  COMPANY
  OTHER
}

// Financeur (ADR 0024, tranche 4.3a) : qui finance. Jamais supprimé ; archivé, il ne reçoit plus de nouvelle demande.
model Funder {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  type        FunderType
  contactName String     @default("")
  email       String     @default("")
  phone       String     @default("")
  note        String     @default("")
  archivedAt  DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  createdBy   String?    @db.Uuid

  grants Grant[]
}

enum GrantStatus {
  REQUESTED
  UNDER_REVIEW
  GRANTED
  REFUSED
  CLOSED
  CANCELLED
}

enum GrantResidual {
  REFUND
  KEPT_WITH_AGREEMENT
  NONE
}

// Subvention : distincte du projet. Demandée, instruite, accordée ou refusée, puis clôturée avec le sort de son reliquat.
// Suivi de gestion : aucune écriture comptable (fonds dédiés = module 6.5, après avis d'expert-comptable). Jamais supprimée.
model Grant {
  id              String         @id @default(uuid()) @db.Uuid
  funderId        String         @db.Uuid
  reference       String?
  title           String
  requestedAmount Decimal        @db.Decimal(14, 2)
  grantedAmount   Decimal?       @db.Decimal(14, 2)
  requestedOn     DateTime?      @db.Date
  decidedOn       DateTime?      @db.Date
  periodStart     DateTime?      @db.Date
  periodEnd       DateTime?      @db.Date
  conditions      String         @default("")
  note            String         @default("")
  status          GrantStatus    @default(REQUESTED)
  // Motif du refus ou de l'annulation.
  reason          String?
  closedOn        DateTime?      @db.Date
  residual        GrantResidual?
  residualNote    String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  createdBy       String?        @db.Uuid

  funder      Funder                   @relation(fields: [funderId], references: [id], onDelete: Restrict)
  allocations GrantProjectAllocation[]
  schedule    GrantSchedule[]
  payments    GrantPayment[]
  expenses    FundingExpenseAllocation[]

  @@index([funderId])
  @@index([status])
}

// Part d'une subvention affectée à un projet. Libre tant que la subvention n'est pas décidée ; à l'accord, la somme des
// parts doit égaler le montant accordé, puis elle ne change plus.
model GrantProjectAllocation {
  id        String  @id @default(uuid()) @db.Uuid
  grantId   String  @db.Uuid
  projectId String  @db.Uuid
  amount    Decimal @db.Decimal(14, 2)

  grant   Grant   @relation(fields: [grantId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([grantId, projectId])
  @@index([projectId])
}

// Échéance d'une subvention accordée : un versement attendu (date, montant, condition). Un plan, pas une écriture.
// La somme des échéances ne dépasse jamais le montant accordé.
model GrantSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  grantId   String   @db.Uuid
  dueOn     DateTime @db.Date
  amount    Decimal  @db.Decimal(14, 2)
  condition String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  createdBy String?  @db.Uuid

  grant    Grant          @relation(fields: [grantId], references: [id], onDelete: Restrict)
  payments GrantPayment[]

  @@index([grantId, dueOn])
}

// Versement reçu : une part d'une transaction (un encaissement) rattachée à une subvention accordée, avec en option
// l'échéance qu'elle règle. Ne crée aucune écriture comptable. Ne se modifie pas : elle s'annule avec un motif.
model GrantPayment {
  id            String    @id @default(uuid()) @db.Uuid
  grantId       String    @db.Uuid
  transactionId String    @db.Uuid
  scheduleId    String?   @db.Uuid
  amount        Decimal   @db.Decimal(14, 2)
  note          String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  createdBy     String?   @db.Uuid
  cancelledAt   DateTime? @db.Timestamptz(3)
  cancelledBy   String?   @db.Uuid
  cancelReason  String?

  grant       Grant          @relation(fields: [grantId], references: [id], onDelete: Restrict)
  transaction Transaction    @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  schedule    GrantSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([grantId])
  @@index([transactionId])
  @@index([scheduleId])
}

// Affectation d'une dépense à une subvention (ADR 0024, tranche 4.4) : une part d'une ligne de charge ventilée sur un projet,
// d'une écriture comptabilisée, que la subvention finance. Suivi de gestion : aucune écriture. Ne se modifie pas : elle
// s'annule avec un motif. Le montant total affecté peut dépasser le montant accordé (signalé, avec un motif de cofinancement
// possible) mais jamais le montant de la dépense elle-même.
model FundingExpenseAllocation {
  id                String    @id @default(uuid()) @db.Uuid
  grantId           String    @db.Uuid
  allocationId      String    @db.Uuid
  amount            Decimal   @db.Decimal(14, 2)
  coFinancingReason String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  createdBy         String?   @db.Uuid
  cancelledAt       DateTime? @db.Timestamptz(3)
  cancelledBy       String?   @db.Uuid
  cancelReason      String?

  grant      Grant                @relation(fields: [grantId], references: [id], onDelete: Restrict)
  allocation AnalyticalAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)

  @@index([grantId])
  @@index([allocationId])
}

enum OperationDirection {
  IN
  OUT
}

// Rôle particulier d'une catégorie d'argent reçu (ADR 0028) : celle qu'on propose d'office pour enregistrer un règlement de
// cotisation ou un versement de subvention. Au plus une catégorie par rôle.
enum OperationUsage {
  MEMBERSHIP
  GRANT
}

// Catégorie d'opération en langage courant (ADR 0028) : cache le numéro de compte du plan au trésorier. Une catégorie
// désigne le compte de contrepartie de l'écriture générée ; elle se désactive, elle ne se supprime pas.
model OperationCategory {
  id        String             @id @default(uuid()) @db.Uuid
  direction OperationDirection
  label     String
  hint      String             @default("")
  accountId String             @db.Uuid
  usage     OperationUsage?
  position  Int                @default(0)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  createdBy String?            @db.Uuid

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

// Situation d'ouverture (ADR 0029) : l'écriture unique qui reprend les soldes de départ (argent, sommes à recevoir et à
// payer, fonds de l'association). Une seule vivante à la fois ; la corriger = supprimer son brouillon ou l'annuler.
model OpeningSituation {
  id        String   @id @default(uuid()) @db.Uuid
  entryId   String   @unique @db.Uuid
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  createdBy String?  @db.Uuid

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}
