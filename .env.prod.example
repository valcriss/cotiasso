# Copier vers .env.prod (ignoré par git) et renseigner les valeurs. Ne jamais versionner .env.prod.

# Mot de passe de la base : long et aléatoire (ex. openssl rand -base64 32). Évitez les caractères : / @ ? # %
POSTGRES_PASSWORD=

# Version des images, à fixer explicitement (pas d'étiquette flottante en production).
COTIASSO_VERSION=0.0.0

# Port HTTP exposé vers votre reverse proxy.
COTIASSO_HTTP_PORT=8080

# Adresse (CIDR) de votre reverse proxy HTTPS, seul autorisé à indiquer l'IP réelle des clients (anti-brute-force).
# Ex. 172.18.0.0/16 si le proxy est un conteneur du même réseau Docker. Par défaut : aucun proxy de confiance.
TRUSTED_PROXY_CIDR=127.0.0.1/32

# Clé de chiffrement des secrets de l'authentification à deux facteurs : 32 octets en base64.
# Générer avec : openssl rand -base64 32. À SAUVEGARDER avec la base (sans elle, tous les seconds facteurs
# deviennent illisibles et doivent être réinitialisés). Ne jamais la perdre, ne jamais la versionner.
MFA_ENCRYPTION_KEY=

# Taille maximale d'un document déposé, en Mo (le proxy accepte jusqu'à 30 Mo par requête).
DOCUMENTS_MAX_MB=25

# Envoi des invitations et des réinitialisations de mot de passe par email (facultatif). Sans SMTP_HOST, rien ne change :
# l'administrateur copie le lien affiché et le transmet lui-même. Dès que SMTP_HOST est renseigné, SMTP_FROM (adresse
# d'expédition) et PUBLIC_URL (adresse publique de l'application, sans « / » final) sont obligatoires. Le chiffrement est exigé :
# STARTTLS sur le port 587 (défaut), ou SMTP_SECURE=true pour le TLS direct (port 465). Détails : docs/exploitation.md.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Adresse publique de l'application, en https et sans « / » final (https://compta.asso.fr). Sert aux liens des emails ET au domaine
# des clés d'accès (Paramètres › Sécurité) : ce domaine doit rester le même, sinon toutes les clés sont à refaire. Détails : docs/exploitation.md.
PUBLIC_URL=

# Vérification des mises à jour (facultatif) : l'écran Paramètres › Exploitation compare la version déployée à la dernière
# version publiée en lisant les étiquettes du dépôt GitHub (requête sortante en lecture seule, sans donnée de l'association).
# UPDATE_CHECK=false la désactive ; UPDATE_CHECK_REPOSITORY (propriétaire/dépôt) pointe vers un fork. Vides : valeurs par défaut.
UPDATE_CHECK=
UPDATE_CHECK_REPOSITORY=

# Sauvegardes : phrase de passe de chiffrement des archives. À conserver SÉPARÉMENT du serveur et de la clé MFA :
# sans elle, les sauvegardes sont illisibles. Générer avec : openssl rand -base64 32
BACKUP_PASSPHRASE=
# Une sauvegarde toutes les N heures ; rétention en jours ; nombre minimal d'archives toujours conservées.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MIN=7

# Copie hors site automatique (facultative mais fortement conseillée : un volume sur la même machine ne protège pas
# d'une perte du serveur). Les archives sont déjà chiffrées ; seules elles quittent le serveur. Renseigner TYPE et PATH
# pour l'activer ; l'état de la copie s'affiche dans Paramètres › Exploitation. Détails et exemples : docs/exploitation.md.
#   S3 / compatible :  OFFSITE_TYPE=s3  OFFSITE_PATH=mon-bucket/cotiasso  OFFSITE_PROVIDER=Other  OFFSITE_ENDPOINT=https://…
#                      OFFSITE_REGION=…  OFFSITE_ACCESS_KEY_ID=…  OFFSITE_SECRET_ACCESS_KEY=…
#   SFTP :             OFFSITE_TYPE=sftp  OFFSITE_PATH=/sauvegardes/cotiasso  OFFSITE_HOST=…  OFFSITE_USER=…
#                      OFFSITE_PASS=<résultat de : rclone obscure 'mot de passe'>
#   WebDAV :           OFFSITE_TYPE=webdav  OFFSITE_PATH=cotiasso  OFFSITE_URL=https://…  OFFSITE_VENDOR=other
#                      OFFSITE_USER=…  OFFSITE_PASS=<résultat de : rclone obscure 'mot de passe'>
#   Dropbox :          OFFSITE_TYPE=dropbox  OFFSITE_PATH=cotiasso
#                      OFFSITE_TOKEN='<valeur « token = » de : rclone config show <remote>, entre apostrophes>'
#                      (facultatif : OFFSITE_CLIENT_ID et OFFSITE_CLIENT_SECRET si votre remote en utilise)
OFFSITE_TYPE=
OFFSITE_PATH=
OFFSITE_PROVIDER=
OFFSITE_ENDPOINT=
OFFSITE_REGION=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_HOST=
OFFSITE_PORT=
OFFSITE_USER=
OFFSITE_PASS=
OFFSITE_URL=
OFFSITE_VENDOR=
OFFSITE_TOKEN=
OFFSITE_CLIENT_ID=
OFFSITE_CLIENT_SECRET=
