# Copier vers .env.prod (ignoré par git) et renseigner les valeurs. Ne jamais versionner .env.prod.

# Mot de passe de la base : long et aléatoire (ex. openssl rand -base64 32). Évitez les caractères : / @ ? # %
POSTGRES_PASSWORD=

# Version des images, à fixer explicitement (pas d'étiquette flottante en production).
COTIASSO_VERSION=0.0.0

# Port HTTP exposé vers votre reverse proxy.
COTIASSO_HTTP_PORT=8080

# Adresse (CIDR) de votre reverse proxy HTTPS, seul autorisé à indiquer l'IP réelle des clients (anti-brute-force).
# Ex. 172.18.0.0/16 si le proxy est un conteneur du même réseau Docker. Par défaut : aucun proxy de confiance.
TRUSTED_PROXY_CIDR=127.0.0.1/32

# Clé de chiffrement des secrets de l'authentification à deux facteurs : 32 octets en base64.
# Générer avec : openssl rand -base64 32. À SAUVEGARDER avec la base (sans elle, tous les seconds facteurs
# deviennent illisibles et doivent être réinitialisés). Ne jamais la perdre, ne jamais la versionner.
MFA_ENCRYPTION_KEY=

# Taille maximale d'un document déposé, en Mo (le proxy accepte jusqu'à 30 Mo par requête).
DOCUMENTS_MAX_MB=25

# Sauvegardes : phrase de passe de chiffrement des archives. À conserver SÉPARÉMENT du serveur et de la clé MFA :
# sans elle, les sauvegardes sont illisibles. Générer avec : openssl rand -base64 32
BACKUP_PASSPHRASE=
# Une sauvegarde toutes les N heures ; rétention en jours ; nombre minimal d'archives toujours conservées.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MIN=7
