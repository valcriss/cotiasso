{
  "name": "cotiasso",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait db",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "npm run db:migrate -w @cotiasso/api",
    "db:generate": "npm run db:generate -w @cotiasso/api",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
